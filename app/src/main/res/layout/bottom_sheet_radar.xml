<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#333333" />

    <!-- Radar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/w_cinema"
            android:text="رادار مانیتورینگ سلامت موتورها"
            android:textColor="@color/header_gray"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshRadar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/estedad"
            android:text="بروزرسانی"
            android:textColor="@color/gold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Overall System Status Box -->
    <LinearLayout
        android:id="@+id/overallStatusBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/overallStatusDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_badge_gold" />

        <TextView
            android:id="@+id/overallStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/estedad_bold"
            android:text="در حال ارزیابی پینگ و وضعیت زیرساخت‌ها..."
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/radarLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/gold" />

    <!-- Services List Container -->
    <LinearLayout
        android:id="@+id/radarServicesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingBottom="20dp" />

</LinearLayout>
