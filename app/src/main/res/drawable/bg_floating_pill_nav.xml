<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Frosted Glass Pill with Gradient & Stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="270"
                android:startColor="#E0171A21"
                android:centerColor="#D4111418"
                android:endColor="#DB0D0E12" />
            <stroke
                android:width="1.2dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Specular Light Reflection at Top of Pill -->
    <item
        android:left="28dp"
        android:right="28dp"
        android:top="1dp"
        android:height="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
