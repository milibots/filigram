<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="تنظیمات پیشرفته دانلود توربو (ADM Pro)"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/yekan_bakh_regular"
            android:text="پیکربندی هوشمند اتصالات، زمان‌بندی شبانه و زیرنویس خودکار"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLabelConcurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="تعداد دانلودهای همزمان (Parallel Items): ۲"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConcurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1.0"
            android:value="2.0"
            android:valueFrom="1.0"
            android:valueTo="4.0"
            app:thumbColor="@color/gold"
            app:trackColorActive="@color/gold"
            app:trackColorInactive="#333333" />

        <TextView
            android:id="@+id/tvLabelThreads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="تعداد تکه‌های هر فایل (Threads / Segments): ۴ تکه"
            android:textColor="@color/gold"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderThreads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1.0"
            android:value="4.0"
            android:valueFrom="1.0"
            android:valueTo="8.0"
            app:thumbColor="@color/gold"
            app:trackColorActive="@color/gold"
            app:trackColorInactive="#333333" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#222222" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="دانلود فقط با Wi-Fi"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/yekan_bakh_regular"
                    android:text="جلوگیری از مصرف بسته اینترنت سیم‌کارت و موبایل دیتا"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWifiOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="دانلود شبانه خودکار (Night Scheduler)"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/yekan_bakh_regular"
                    android:text="فعال‌سازی دانلودها فقط بین ساعت ۲ تا ۷ صبح (اینترنت شبانه)"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNightScheduler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="دانلود خودکار زیرنویس هماهنگ (.srt)"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/yekan_bakh_regular"
                    android:text="دریافت فایل زیرنویس فارسی با انکودینگ اصلاح‌شده کنار فایل ویدیو"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoSubtitles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/selector_switch_thumb"
                app:trackTint="@color/selector_switch_track" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="مسیر ذخیره‌سازی فایل‌ها:"
            android:textColor="@color/header_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCurrentStoragePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_input"
            android:fontFamily="@font/yekan_bakh_regular"
            android:padding="10dp"
            android:text="Download/Filigram (پیش‌فرض)"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeStorageLocation"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="تغییر پوشه دانلود (کارت حافظه / مسیر دلخواه)"
            android:textColor="@color/gold"
            android:textSize="11sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/gold_dim"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDownloadSettings"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/gold"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="ذخیره تنظیمات"
            android:textColor="@color/black"
            android:textSize="13sp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
