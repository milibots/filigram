<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Filigram" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">@font/estedad</item>
        <item name="android:fontFamily">@font/estedad</item>
        <!-- Smooth activity/dialog transitions -->
        <item name="android:windowAnimationStyle">@style/Anim.Filigram.Window</item>
    </style>

    <!-- Window animation style for Activity transitions -->
    <style name="Anim.Filigram.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fullscreen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/dialog_slide_down</item>
        <item name="android:activityCloseEnterAnimation">@anim/dialog_slide_up</item>
        <item name="android:activityCloseExitAnimation">@anim/fullscreen_exit</item>
        <item name="android:windowEnterAnimation">@anim/fullscreen_enter</item>
        <item name="android:windowExitAnimation">@anim/fullscreen_exit</item>
    </style>

    <!-- Full-screen Dialog animation style -->
    <style name="Anim.Filigram.Dialog.Fullscreen" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/fullscreen_enter</item>
        <item name="android:windowExitAnimation">@anim/fullscreen_exit</item>
    </style>

    <!-- Compact Dialog animation style (for modal dialogs) -->
    <style name="Anim.Filigram.Dialog.Compact" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_up</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_down</item>
    </style>

    <!-- Floating Pill Bottom Navigation Style -->
    <style name="Widget.Filigram.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="fontFamily">@font/estedad_bold</item>
        <item name="android:fontFamily">@font/estedad_bold</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Filigram.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Filigram.NavInactive</item>
        <item name="itemBackground">@drawable/bg_nav_item_button</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemRippleColor">@color/gold_glow</item>
    </style>

    <style name="TextAppearance.Filigram.NavActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/estedad_bold</item>
        <item name="android:fontFamily">@font/estedad_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <style name="TextAppearance.Filigram.NavInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/estedad</item>
        <item name="android:fontFamily">@font/estedad</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
