<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS everywhere, and system CAs only: user-installed CAs would let any local
         proxy read the traffic. RezFlix is the one source still served over plain HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">server-win-iran.info</domain>
    </domain-config>
</network-security-config>
