<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/topBarEnginesDrawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#0A0A0A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="38dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDrawerClose"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="بازگشت"
            android:textColor="@color/gold"
            android:textSize="13sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="تنظیمات فیلیگرام"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentEngineSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/yekan_bakh_regular"
                android:text="سیاره فعال: زهره (پیش‌فرض)"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="فیلیگرام"
            android:src="@drawable/app_logo_filigram" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpenRadar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_search_input"
                        android:padding="7dp"
                        android:src="@drawable/ic_radar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:text="وضعیت و پایداری سرورها (Status)"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="بررسی پینگ لحظه‌ای، تاخیر و سلامت اتصال سرورها"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="مشاهده وضعیت"
                        android:textColor="@color/gold"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDrawerTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_search_input"
                        android:padding="8dp"
                        android:src="@drawable/ic_telegram_plane"
                        app:tint="@color/gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:text="پشتیبانی و ارتباط با ما (Contact Support)"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="ارتباط مستقیم، پشتیبانی و گزارش باگ در تلگرام: t.me/filigramapp?direct"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="ارتباط با پشتیبانی"
                        android:textColor="@color/gold"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardClearCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_search_input"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="@color/gold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:text="پاکسازی حافظه موقت (Clear Cache)"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCacheSizeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="حجم کش ذخیره‌شده: در حال محاسبه..."
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="پاکسازی کش"
                        android:textColor="@color/gold"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="انتخاب سیاره منبع محتوا (Planets):"
                android:textColor="@color/header_gray"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/rgEngines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RadioButton
                        android:id="@+id/rbMovielix"
                        android:drawableStart="@drawable/ic_planet_venus"
                        android:drawablePadding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="8dp"
                        android:text="سیاره زهره — سرور اختصاصی و پایدار"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:text="کامل‌ترین پایگاه عناوین سینمایی با استریم روان و کیفیت‌های متنوع"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbRezFlix"
                        android:drawableStart="@drawable/ic_planet_neptune"
                        android:drawablePadding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="8dp"
                        android:text="سیاره نپتون — سرور کمکی"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:text="سرور پردازش موازی با لینک‌های مستقیم و پرسرعت"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbAlmasMovie"
                        android:drawableStart="@drawable/ic_planet_uranus"
                        android:drawablePadding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="8dp"
                        android:text="سیاره اورانوس — پایگاه چندکیفیتی"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:text="پایگاه داده مستقیم فیلم‌ها و سریال‌ها با سرعت بالا و زیرنویس چسبیده"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbNextMovie"
                        android:drawableStart="@drawable/ic_planet_saturn"
                        android:drawablePadding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="8dp"
                        android:text="سیاره زحل — پایگاه پرسرعت"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:text="سرویس فیلم‌ها و سریال‌های روز با لینک‌های استریم مستقیم بدون محدودیت"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                    <RadioButton
                        android:id="@+id/rbBjEngine"
                        android:drawableStart="@drawable/ic_planet_jupiter"
                        android:drawablePadding="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:buttonTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="8dp"
                        android:text="سیاره مشتری (اختصاصی فیلیگرام)"
                        android:textColor="@android:color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:text="آرشیو جامع فیلم، سریال و انیمیشن با لینک‌های مستقیم و پرسرعت و زیرنویس اختصاصی"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />

                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyEngine"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/gold"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="اعمال و تغییر موتور فعال"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:cornerRadius="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="مشخصات دستگاه و نسخه برنامه"
                android:textColor="@color/gold"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="مدل و برند دستگاه:"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeviceInfoModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1C1C1E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="معماری پردازنده (CPU ABI):"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeviceInfoCpu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_input"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/gold"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1C1C1E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="نسخه اندروید و SDK:"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeviceInfoAndroid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:textColor="@android:color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1C1C1E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="نسخه اپلیکیشن فیلیگرام:"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeviceInfoAppVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_bold"
                            android:textColor="@color/gold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#1C1C1E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:text="تاریخ و زمان نصب برنامه:"
                            android:textColor="@color/muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDeviceInfoInstallDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/yekan_bakh_regular"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="#222222" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_heart_filled_gold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="حمایت مالی از پروژه فیلیگرام (Donation)"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDonationWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:lineSpacingExtra="4dp"
                        android:text="برای حمایت از پایداری سرورها و توسعه مداوم فیلیگرام، می‌توانید کمک‌های مالی خود را به آدرس کیف پول ترون زیر (تتر USDT-TRC20 یا TRX) واریز نمایید:"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <!-- Network badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_search_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp">

                        <ImageView
