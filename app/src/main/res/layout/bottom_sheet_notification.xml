<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp">

    <!-- Handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="#33FFFFFF" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_glass"
        android:padding="16dp">

        <!-- Icon -->
        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_input"
            android:padding="11dp"
            android:src="@drawable/ic_star_gold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/notifTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="در حال پردازش..."
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/notifIcon"
            app:layout_constraintTop_toTopOf="@id/notifIcon" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/notifSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/yekan_bakh_regular"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/notifIcon"
            app:layout_constraintTop_toBottomOf="@id/notifTitle" />

        <!-- Loading bar (shown only for loading states) -->
        <ProgressBar
            android:id="@+id/notifProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/gold"
            android:progressTint="@color/gold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notifIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
