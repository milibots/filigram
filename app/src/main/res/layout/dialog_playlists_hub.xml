<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/topBarPlaylistsHub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="@drawable/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="38dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackPlaylistsHub"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="بازگشت"
            android:textColor="@color/gold"
            android:textSize="13sp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/gold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="کتابخانه من"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateNewPlaylist"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#000000"
            android:fontFamily="@font/yekan_bakh_bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+ پلی‌لیست جدید"
            android:textColor="@color/gold"
            android:textSize="11sp"
            app:cornerRadius="18dp"
            app:strokeColor="@color/gold_dim"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/tabFavorites"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/icTabFav"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_heart_filled_gold"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/txtTabFav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="علاقه‌مندی‌ها"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeFavCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_counter_pill"
                android:fontFamily="@font/yekan_bakh_bold"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="۰"
                android:textColor="@android:color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPlaylists"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/icTabPlaylists"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_playlist_vector"
                app:tint="@color/muted" />

            <TextView
                android:id="@+id/txtTabPlaylists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="پلی‌لیست‌ها"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgePlaylistsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_counter_pill"
                android:fontFamily="@font/yekan_bakh_bold"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="۰"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/icTabHistory"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_history_vector"
                app:tint="@color/muted" />

            <TextView
                android:id="@+id/txtTabHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="تاریخچه"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeHistoryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_counter_pill"
                android:fontFamily="@font/yekan_bakh_bold"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="۰"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/containerFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerActionsFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/txtFavHeaderCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="آرشیو فیلم‌ها و سریال‌های نشان‌شده"
                    android:textColor="@color/header_gray"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportFavorites"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="خروجی JSON"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportFavorites"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="ورودی JSON"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAllFavorites"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="حذف همه نشان‌ها"
                    android:textColor="#FF5555"
                    android:textSize="12sp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="#FF5555" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFavoritesHub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="24dp" />

                <LinearLayout
                    android:id="@+id/emptyFavoritesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="60dp"
                        app:strokeColor="@color/gold_dim"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="26dp"
                            android:src="@drawable/ic_heart_outline_gold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="هنوز فیلمی را نشان نکرده‌اید!"
                        android:textColor="@color/header_gray"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="با زدن آیکون قلب در جزییات فیلم‌ها، آن‌ها در این تب ذخیره می‌شوند."
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerPlaylists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/headerActionsPlaylists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/txtPlaylistsHeaderCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="مجموعه‌های شخصی شما"
                    android:textColor="@color/header_gray"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportPlaylists"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="خروجی JSON"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportPlaylists"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="ورودی JSON"
                    android:textColor="@color/gold"
                    android:textSize="11sp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAllPlaylists"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="حذف همه پلی‌لیست‌ها"
                    android:textColor="#FF5555"
                    android:textSize="12sp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconPadding="4dp"
                    app:iconSize="16dp"
                    app:iconTint="#FF5555" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPlaylistsHub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp" />

                <LinearLayout
                    android:id="@+id/emptyPlaylistsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="60dp"
                        app:strokeColor="@color/gold_dim"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="26dp"
                            android:src="@drawable/ic_playlist_vector"
                            app:tint="@color/gold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="هنوز پلی‌لیستی ایجاد نکرده‌اید!"
                        android:textColor="@color/header_gray"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="شما می‌توانید مجموعه‌های دلخواه خود را ساخته و فیلم‌های مدنظرتان را به آن اضافه کنید."
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyCreatePlaylist"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/gold"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="+ ایجاد اولین پلی‌لیست"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:cornerRadius="21dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/headerActionsHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/txtHistoryHeaderCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/yekan_bakh_regular"
                    android:text="عناوین مشاهده‌شده (۰ عنوان)"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAllHistory"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="پاکسازی تاریخچه"
                    android:textColor="#FF4444"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistoryHub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="40dp" />

                <LinearLayout
                    android:id="@+id/emptyHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        app:cardBackgroundColor="@color/card"
                        app:cardCornerRadius="45dp"
                        app:strokeColor="@color/gold_dim"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="24dp"
                            android:src="@drawable/ic_history_vector"
                            app:tint="@color/gold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/yekan_bakh_bold"
                        android:text="تاریخچه خالی است!"
                        android:textColor="@color/header_gray"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/yekan_bakh_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="هر فیلم یا سریالی که باز کنید و تماشا کنید، در تاریخچه شما ثبت خواهد شد."
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
