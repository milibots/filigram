<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp"
    android:layoutDirection="rtl">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#333333" />

    <TextView
        android:id="@+id/tvAddToPlaylistTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yekan_bakh_bold"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:text="افزودن به پلی‌لیست" />

    <TextView
        android:id="@+id/tvAddToPlaylistSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/yekan_bakh_regular"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:text="انتخاب پلی‌لیست:" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutPlaylistsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tvNoPlaylistsNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/yekan_bakh_regular"
        android:textColor="@color/sub"
        android:textSize="12sp"
        android:layout_marginVertical="16dp"
        android:visibility="gone"
        android:text="هنوز هیچ پلی‌لیستی ایجاد نکرده‌اید." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreatePlaylistFromAdd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/gold"
        android:fontFamily="@font/yekan_bakh_bold"
        android:text="+ ایجاد پلی‌لیست جدید"
        android:textColor="@color/black"
        app:cornerRadius="16dp" />

</LinearLayout>
