<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fullscreen Cover Hero Banner (Netflix-Style Edge-to-Edge, No Header Bar!) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="400dp">

            <!-- High-Res Cover Poster Backdrop (Full Bleed from Screen Top) -->
            <ImageView
                android:id="@+id/detailPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_banner" />

            <!-- Top Subtle Vignette for Floating Controls Visibility -->
            <View
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_top_gradient" />

            <!-- Bottom Cinematic Fade into Deep Black Surface -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_banner_gradient" />

            <!-- Floating Translucent Top Controls (Safe Cutout Padded) -->
            <LinearLayout
                android:id="@+id/topBarDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="38dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Floating Frosted Back Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackDetail"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#80000000"
                    android:fontFamily="@font/estedad_bold"
                    android:text="بازگشت"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="@android:color/white"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Floating Frosted Playlist Button -->
                <ImageButton
                    android:id="@+id/btnAddPlaylistDetail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="افزودن به پلی‌لیست"
                    android:padding="9dp"
                    android:src="@drawable/ic_playlist_vector"
                    app:tint="@android:color/white" />

                <!-- Floating Frosted Favorite / Bookmark Button -->
                <ImageButton
                    android:id="@+id/btnFavoriteDetail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="نشان کردن و ذخیره"
                    android:padding="9dp"
                    android:src="@drawable/ic_heart_outline_gold" />

                <!-- Floating Frosted Series Notification Bell Button -->
                <ImageButton
                    android:id="@+id/btnNotifySeriesDetail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="اعلان قسمت جدید"
                    android:padding="9dp"
                    android:src="@drawable/ic_bell_gold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Bottom Title and Badges directly over the gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/detailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/w_cinema"
                    android:shadowColor="#DD000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Badges & Ratings Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_gold"
                        android:fontFamily="@font/estedad_bold"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="فیلم"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/detailImdb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_search_input"
                        android:drawableStart="@drawable/ic_star_gold"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/estedad_bold"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="7.5"
                        android:textColor="@color/gold"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/detailYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/estedad"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Body Content Under the Fullscreen Cover -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Plot Storyline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/w_cinema"
                android:text="خلاصه داستان:"
                android:textColor="@color/header_gray"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detailPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/estedad"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <!-- Action Button: Add to Playlists -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionAddToPlaylist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/estedad_bold"
                android:text="افزودن به پلی‌لیست‌های اختصاصی"
                android:textColor="@color/gold"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_playlist_vector"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/gold"
                app:strokeColor="@color/gold_dim"
                app:strokeWidth="1.2dp" />

            <!-- Series Controls: Seasons & Episodes -->
            <LinearLayout
                android:id="@+id/seriesControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Series Notification Follow/Unfollow Banner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeriesNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1A1810"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#40D4AF37"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgSeriesNotificationBell"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_dialog_glass"
                            android:padding="8dp"
                            android:src="@drawable/ic_bell_gold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSeriesNotificationTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/w_cinema"
                                android:text="اعلان قسمت‌های جدید"
                                android:textColor="@color/header_gray"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSeriesNotificationStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/estedad"
                                android:text="خاموش — به محض انتشار قسمت جدید باخبر شوید"
                                android:textColor="@color/muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleSeriesNotification"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:backgroundTint="#26D4AF37"
                            android:fontFamily="@font/estedad_bold"
                            android:text="روشن کردن"
                            android:textColor="@color/gold"
                            android:textSize="11sp"
                            app:cornerRadius="19dp"
                            app:strokeColor="@color/gold"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/w_cinema"
                    android:text="انتخاب فصل:"
                    android:textColor="@color/header_gray"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/w_cinema"
                    android:text="انتخاب قسمت:"
                    android:textColor="@color/header_gray"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Qualities & Downloads Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/w_cinema"
                android:text="کیفیت‌های پخش آنلاین و دانلود مستقیم:"
                android:textColor="@color/header_gray"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/detailLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/gold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/qualityListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
