<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp"
    android:layoutDirection="rtl">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="#333333" />

    <!-- Header Row: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#1C1E24"
            app:cardCornerRadius="26dp"
            app:strokeColor="#2ECC71"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="13dp"
                android:src="@drawable/ic_telegram_plane"
                app:tint="#2ECC71"
                android:contentDescription="Share" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/yekan_bakh_bold"
                android:text="معرفی فیلیگرام"
                android:textColor="@android:color/white"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/yekan_bakh_regular"
                android:text="اپ را با دوستانت به اشتراک بگذار"
                android:textColor="#888888"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yekan_bakh_regular"
        android:text="با اشتراک‌گذاری فیلیگرام به دوستانت کمک کن تا به دنیای فیلم و سریال بدون محدودیت دسترسی داشته باشند."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:lineSpacingExtra="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="22dp" />

    <!-- Option 1: Share Telegram Channel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShareTelegram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#1C1E24"
        app:cardCornerRadius="16dp"
        app:strokeColor="#2A2D36"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Telegram icon circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="#0E3329"
                app:cardCornerRadius="22dp"
                app:strokeColor="#2ECC71"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:src="@drawable/ic_telegram_plane"
                    app:tint="#2ECC71"
                    android:contentDescription="Telegram" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="اشتراک‌گذاری کانال تلگرام"
                    android:textColor="@android:color/white"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="monospace"
                    android:text="t.me/filigramapp"
                    android:textColor="#2ECC71"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="#555555"
                android:contentDescription="Go" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Option 2: Share APK Download Link -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShareApk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#1C1E24"
        app:cardCornerRadius="16dp"
        app:strokeColor="#2A2D36"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Download icon circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="#1A1000"
                app:cardCornerRadius="22dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:src="@drawable/ic_download_vector"
                    app:tint="@color/gold"
                    android:contentDescription="Download APK" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/yekan_bakh_bold"
                    android:text="اشتراک‌گذاری لینک دانلود APK"
                    android:textColor="@android:color/white"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/yekan_bakh_regular"
                    android:text="لینک جدیدترین نسخه از GitHub"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="#555555"
                android:contentDescription="Go" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dismiss button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareDismiss"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="@font/yekan_bakh_regular"
        android:text="بستن"
        android:textColor="#AAAAAA"
        app:cornerRadius="16dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp" />

</LinearLayout>
