<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_bottom"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp"
    android:layoutDirection="rtl">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#333333" />

    <TextView
        android:id="@+id/tvCreatePlaylistTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/yekan_bakh_bold"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:text="ایجاد پلی‌لیست جدید" />

    <TextView
        android:id="@+id/tvCreatePlaylistSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/yekan_bakh_regular"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:text="نامی مناسب برای کالکشن خود وارد کنید:" />

    <EditText
        android:id="@+id/etPlaylistNameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_input"
        android:fontFamily="@font/yekan_bakh_regular"
        android:hint="مثلاً: فیلم‌های اکشن ۲۰۲۴"
        android:textColorHint="#666666"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="18dp"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCreatePlaylist"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/yekan_bakh_regular"
            android:text="انصراف"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitCreatePlaylist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/gold"
            android:fontFamily="@font/yekan_bakh_bold"
            android:text="ایجاد پلی‌لیست"
            android:textColor="@color/black"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>
